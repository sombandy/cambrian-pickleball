# Copy to .env.local. Only DATABASE_URL is required to run locally.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required. Local Postgres database (create it first: createdb cambrian_pickleball).
DATABASE_URL=postgresql://localhost:5432/cambrian_pickleball

# Optional: Clerk. Leave blank to run without sign-in; the tournament pages
# still work, but the feedback board, /admin, and /sign-in will error.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Tournament scoring: one shared Clerk account ID (user_...), or comma-separated IDs.
# Public visitors can read; all writes are denied when this is blank.
TOURNAMENT_EDITOR_USER_IDS=

# Optional direct Google Sheets export. Public OAuth web client ID, not a secret.
# Configure the site's origin in Google Cloud and enable Google Sheets API.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: comma-separated emails treated as admins (needs Clerk).
ADMIN_BOOTSTRAP_EMAILS=

# Optional: rankings pages. Without these, /rankings stays locked or empty.
RANKINGS_API_URL=
RANKINGS_PASSWORD=
LEADERBOARD_API_KEY=
